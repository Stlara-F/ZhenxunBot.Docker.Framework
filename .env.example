# ============================================================================
# Zhenxun Docker Framework 环境变量示例
# 复制为 .env 并修改, 或在 docker compose 的 environment: 中直接设置
# 所有变量均有安全默认值; 除超级用户外, 开箱即可启动
# ============================================================================

# ---- 基础 ----
TZ=Asia/Shanghai
# 容器内 zhenxun 用户 uid/gid (与宿主机用户保持一致可避免挂载目录权限问题)
ZHENXUN_UID=1000
ZHENXUN_GID=1000

# ---- 机器人核心 (写入 .env.dev) ----
# 超级用户 QQ 号 (JSON 数组)
SUPERUSERS=["123456789"]
# 指令前缀 (JSON 数组)
COMMAND_START=["/"]
# 昵称 (JSON 数组)
NICKNAME=["真寻", "小真寻", "绪山真寻", "小寻子"]
# 平台超级用户 (JSON 对象: {"qq": ["123456789"]})
PLATFORM_SUPERUSERS={"qq": ["123456789"]}
# OneBot 反向 WS 访问令牌, 需与 QQ 客户端 (如 NapCat) 配置一致
# ONEBOT_ACCESS_TOKEN=your_token

# ---- 数据库 (默认自动组装 postgres://zhenxun:<DB_PASSWORD>@db:5432/zhenxun) ----
# 也可直接指定完整连接串, 支持 postgres / mysql / sqlite
# DB_URL=postgres://zhenxun:zhenxun@db:5432/zhenxun
DB_HOST=db
DB_PORT=5432
DB_USER=zhenxun
DB_PASSWORD=zhenxun
DB_NAME=zhenxun
# 启动时是否等待数据库就绪 (1/0) 与超时秒数
DB_WAIT=1
DB_WAIT_TIMEOUT=120

# ---- 缓存 (NONE / MEMORY / REDIS) ----
CACHE_MODE=REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_EXPIRE=600

# ---- 服务监听 (容器内固定 8080, 宿主机端口由 compose 映射) ----
HOST=0.0.0.0
PORT=8080

# ---- WebUI (内置, 端口 8080; 未设置密码时启动会生成临时密码并打印到日志) ----
WEBUI_USERNAME=admin
# WEBUI_PASSWORD=change_me

# ---- 日志 ----
# LOG_LEVEL=INFO

# ---- 代理 ----
# SYSTEM_PROXY=http://127.0.0.1:7890

# ---- 构建版本 (构建镜像时使用, 默认 main) ----
# ZHENXUN_REF=main
# PLUGINS_REF=main
# RESOURCES_REF=main

# ---- 可选: NapCat QQ 客户端 (docker compose --profile onebot up -d) ----
# NAPCAT_UID=1000
# NAPCAT_GID=1000
# NAPCAT_ACCOUNT=123456789
# NAPCAT_WEBUI_TOKEN=your_webui_token
# NAPCAT_WEBUI_PORT=6099
